# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# datos ficticios del caso: nunca se publican
/data/seed/*
!/data/seed/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored tool/library reference docs auto-fetched by the skills system
/.agents/
/.claude/*
/skills-lock.json

# project conventions for Claude Code (committed)
!/.claude/agents/
!/.claude/rules/

# documentos con cifras del caso (datos ficticios, no publicar)
/docs/PLAN.md
/docs/ENTREGA_CASO1.md
/docs/VALIDACION.md
/docs/BACKTEST.md
