# Postgres local (instalado en la maquina, puerto 5432) o el connection string
# de Neon en Vercel. En Neon, usa el connection string "pooled" para funciones
# serverless.
DATABASE_URL="postgres://localhost:5432/pedido_inteligente"

# Login de un solo usuario demo (cookie firmada con iron-session).
ADMIN_EMAIL="planificador@demo.local"
ADMIN_PASSWORD=""
# openssl rand -base64 32
SESSION_SECRET=""

# Opcional: activa las sugerencias de IA para mapear alias. Sin esta variable
# la app funciona igual, solo sin sugerencias automaticas.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
